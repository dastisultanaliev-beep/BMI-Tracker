import sqlite3
from datetime import datetime

import customtkinter as ctk


conn = sqlite3.connect("bmi_history.db")

conn.execute("""
    CREATE TABLE IF NOT EXISTS history (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        date TEXT,
        weight REAL,
        height REAL,
        bmi REAL
    )
""")


def show_history():
    history_box.delete("1.0", "end")

    rows = conn.execute(
        "SELECT * FROM history ORDER BY rowid DESC"
    ).fetchall()

    for id, date, weight, height, bmi in rows:
        history_box.insert(
            "end",
            f"{date} | {weight} kg, {height} cm | BMI {bmi}\n"
        )


def calculate():
    try:
        weight = float(weight_entry.get())
        height = float(height_entry.get())
    except ValueError:
        result_label.configure(text="Enter numbers")
        return

    bmi = round(weight / (height / 100) ** 2, 1)

    if bmi < 18.5:
        text = "Underweight"
    elif bmi < 25:
        text = "Normal weight"
    elif bmi < 30:
        text = "Overweight"
    else:
        text = "Obesity"

    result_label.configure(
        text=f"BMI: {bmi} - {text}"
    )

    date = datetime.now().strftime("%d.%m.%Y %H:%M")

    conn.execute(
        """
        INSERT INTO history (date, weight, height, bmi)
        VALUES (?, ?, ?, ?)
        """,
        (date, weight, height, bmi)
    )

    conn.commit()
    show_history()


def clear_history():
    conn.execute("DELETE FROM history")
    conn.commit()
    show_history()


app = ctk.CTk()

app.title("BMI Tracker")
app.geometry("400x500")


weight_entry = ctk.CTkEntry(
    app,
    placeholder_text="Weight (kg)"
)
weight_entry.pack(pady=10)


height_entry = ctk.CTkEntry(
    app,
    placeholder_text="Height (cm)"
)
height_entry.pack(pady=10)


ctk.CTkButton(
    app,
    text="Calculate",
    command=calculate
).pack(pady=10)


result_label = ctk.CTkLabel(
    app,
    text="",
    font=("Arial", 18)
)
result_label.pack(pady=10)


history_box = ctk.CTkTextbox(
    app,
    width=360,
    height=220
)
history_box.pack(pady=10)


ctk.CTkButton(
    app,
    text="Clear History",
    command=clear_history
).pack(pady=10)


show_history()

app.mainloop()
